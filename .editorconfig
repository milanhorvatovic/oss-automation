root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
# The same width ruff formats to, so an editor and the formatter do not
# disagree about where a line ends.
max_line_length = 100

[*.{yaml,yml,toml,json,md}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown, not whitespace to trim.
trim_trailing_whitespace = false
